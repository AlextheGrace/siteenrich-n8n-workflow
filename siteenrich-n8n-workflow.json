            },
            {
              "id": "14521e5d-c617-4aff-85f7-03f68c9cedcb",
              "name": "is_negative_signal",
              "value": "={{ [\"agency\", \"marketing_tool\", \"lead_gen_tool\"].includes(JSON.parse($json.choices[0].message.content).category) }}",
              "type": "boolean"
            },
            {
              "id": "4e22fdb6-7e55-4a80-a91e-5046672e7ad7",
              "name": "apollo_tier",
              "value": "={{ [\"agency\", \"marketing_tool\", \"lead_gen_tool\"].includes(JSON.parse($json.choices[0].message.content).category) ? 'skip' : JSON.parse($json.choices[0].message.content).confidence > 0.85 ? 'narrow' : JSON.parse($json.choices[0].message.content).confidence > 0.65 ? 'broader' : JSON.parse($json.choices[0].message.content).confidence > 0.5 ? 'broadest' : 'skip' }}",
              "type": "string"
            },
            {
              "id": "9d572c5b-32b1-4956-b2c5-96fe406c8656",
              "name": "is_skip",
              "value": "={{ [\"agency\", \"marketing_tool\", \"lead_gen_tool\"].includes(JSON.parse($json.choices[0].message.content).category) || JSON.parse($json.choices[0].message.content).confidence < 0.5 }}",
