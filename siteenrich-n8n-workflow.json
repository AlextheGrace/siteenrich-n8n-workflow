        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a B2B company classifier. Given the website signals of a company, classify it into exactly ONE of these categories: saas_b2b, saas_b2c, agency, marketing_tool, lead_gen_tool, consulting, manufacturer, ecommerce, marketplace, professional_services, parked, unknown. Return JSON with: category (one of the categories above), confidence (0-1 number, be conservative \\u2014 only use >0.85 when website signals are unambiguous), signals (2-4 short strings listing the specific evidence you used), and uncertainty_reason (string explaining what made you uncertain, or null if confidence > 0.85). Categories agency/marketing_tool/lead_gen_tool are 'meta-prospects' \\u2014 companies that themselves sell to B2B, so flag them honestly even if the site looks professional.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Domain: {{ $json.domain || 'unknown' }}\\nCompany name: {{ $json.companyName || 'unknown' }}\\nHas careers page: {{ ($json.signals && $json.signals.hasCareersPage) ? 'true' : 'false' }}\\nHas pricing page: {{ ($json.signals && $json.signals.hasPricingPage) ? 'true' : 'false' }}\\nEmails found: {{ ($json.emails || []).join(', ') || 'none' }}\\nSocials: {{ ($json.socials || []).join(', ') || 'none' }}\"\n    }\n  ],\n  \"response_format\": {\n    \"type\": \"json_schema\",\n    \"json_schema\": {\n      \"name\": \"company_classification\",\n      \"strict\": true,\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"category\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"saas_b2b\",\n              \"saas_b2c\",\n              \"agency\",\n              \"marketing_tool\",\n              \"lead_gen_tool\",\n              \"consulting\",\n              \"manufacturer\",\n              \"ecommerce\",\n              \"marketplace\",\n              \"professional_services\",\n              \"parked\",\n              \"unknown\"\n            ]\n          },\n          \"confidence\": {\n            \"type\": \"number\",\n            \"minimum\": 0,\n            \"maximum\": 1\n          },\n          \"signals\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"minItems\": 1,\n            \"maxItems\": 6\n          },\n          \"uncertainty_reason\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          }\n        },\n        \"required\": [\n          \"category\",\n          \"confidence\",\n          \"signals\",\n          \"uncertainty_reason\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  }\n}",
        "options": {}
